<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="RWComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#4A4A4A"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="25"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="ComboBox">

                    <Grid>

                        <Border
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        Background="{TemplateBinding Background}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="25"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                Margin="2,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"/>

                                <ToggleButton
                                Grid.Column="1"
                                    BorderThickness="0"
                                    Background="#4A4A4A"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">

                                    <Border Background="Transparent">

                                        <Image Source="/Assets/dropdown.png"
                                               Height="12"
                                               Width="12"/>

                                    </Border>

                                </ToggleButton>

                            </Grid>

                        </Border>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}">

                            <Border
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                Background="#2B2F36"
                                BorderBrush="#4A4A4A"
                                BorderThickness="1">

                                <ScrollViewer MaxHeight="400">
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>

                            </Border>

                        </Popup>

                    </Grid>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

        <Setter Property="ItemContainerStyle">

            <Setter.Value>
                <Style TargetType="ComboBoxItem">

                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#2B2F36"/>
                    <Setter Property="Padding" Value="2,0,0,0"/>
                    <Setter Property="Height" Value="20"/>

                    <Style.Triggers>

                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#3C4047"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#1683FF"/>
                        </Trigger>

                    </Style.Triggers>

                </Style>

            </Setter.Value>

        </Setter>

    </Style>
</ResourceDictionary>