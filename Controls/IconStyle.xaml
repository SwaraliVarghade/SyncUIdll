<UserControl x:Class="SyncUI.Controls.IconStyle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center">
            <Image x:Name="Icon"
               Width="14"
               Height="14"
               Margin="0,1,5,0"
               Source="{Binding IconSource, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <TextBlock x:Name="Text"
               VerticalAlignment="Center"
                       Margin="0,-1,0,0"
               Text="{Binding ButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </StackPanel>
    </Grid>
</UserControl>
